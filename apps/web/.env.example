# apps/web — copy to .env.local and fill in. Never commit .env.local.
# Variables from docs/DEPENDENCIES.md §5. The secret key never goes in the web app.

# Supabase API URL and publishable (RLS-limited) key (D32). Dev uses the cloud project
# lp-platform-dev (D73): https://<project-ref>.supabase.co, and Dashboard → Project Settings →
# API Keys → Publishable key. With the optional Docker stack (pnpm db:local:start) use
# http://127.0.0.1:54321 and the key from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Internal worker API base URL (server-side only; never exposed to the browser)
WORKER_API_URL=http://localhost:8000

# Public URL of the web app (OAuth redirects, links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
