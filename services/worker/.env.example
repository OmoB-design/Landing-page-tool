# services/worker — copy to .env and fill in. Never commit .env.
# Variables from docs/DEPENDENCIES.md §5. Secrets are blank; non-secret defaults are filled in.
# The worker loads this file itself (pydantic-settings, from B0.4). Do not `source` it in your
# shell: zsh mangles values containing ${...} (lesson from the reference tool).
#
# Per-org secrets (Vercel tokens, Shopify client secrets and access tokens) are NOT env vars.
# They live in Supabase Vault and are referenced by id from integrations / store_connections.

# ── Supabase ────────────────────────────────────────────────────────────────
# Local values come from `supabase status`. Keys are the newer publishable/secret kind (D32).
# How user JWTs are verified (JWT secret or JWKS) is decided at B0.4.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres connection (job queue, LangGraph checkpoints)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Providers (paid; never called without the owner's explicit go) ──────────
ANTHROPIC_API_KEY=
FAL_KEY=

# ── Models (configuration, never hard-coded; D14) ───────────────────────────
LP_MODEL_COPY=claude-sonnet-5-5
LP_MODEL_VISION=claude-sonnet-5-5
LP_MODEL_ANALYSIS=claude-sonnet-5-5
LP_MODEL_AGENT=claude-sonnet-5-5
LP_MODEL_FAST=claude-haiku-4-5-20251001
LP_FAL_T2I_MODEL=fal-ai/nano-banana-pro
LP_FAL_EDIT_MODEL=fal-ai/nano-banana-pro/edit

# ── Mock mode (D15, D31) ────────────────────────────────────────────────────
# 1 = free local placeholder images. Set 0 explicitly for real fal images.
LP_MOCK_IMAGES=1
# 1 = fake LLM (ledger rows at $0). Set 0 explicitly for real Claude calls.
LP_MOCK_LLM=1

# ── Clone path (M2) ─────────────────────────────────────────────────────────
# Residential proxy URL; only used when the org flag proxy_fetch_enabled is on (off by default; D4)
LP_FETCH_PROXY=
# Publish gate threshold for cloned builds (D28)
LP_RESIDUE_MIN_SCORE=85

# ── Job loop ────────────────────────────────────────────────────────────────
LP_WORKER_CONCURRENCY=3
LP_ORG_CONCURRENCY=2

# ── Shopify ─────────────────────────────────────────────────────────────────
# Admin GraphQL version: set to the current stable version when Shopify publish is built (B1.5)
SHOPIFY_API_VERSION=

# ── App ─────────────────────────────────────────────────────────────────────
# Public web app URL, for OAuth redirect URIs
APP_URL=http://localhost:3000
LOG_LEVEL=info
